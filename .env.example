# Copy this file to .env and fill in real values.
# .env must NEVER be committed to Git.

DB_HOST=127.0.0.1
DB_NAME=travelease
DB_USER=root
DB_PASS=
DB_PORT=3306

# Used for session/CSRF token generation. Generate a long random string.
APP_SECRET=change_this_to_a_long_random_string

# From Google Cloud Console > APIs & Services > Credentials.
# This is the CLIENT ID only -- it is safe to expose to the browser.
# The client secret is NOT used by this app (ID token verification
# does not require it) and should never be placed here or anywhere
# in source code.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Set to "development" or "production".
# In production, error details are never shown to users.
APP_ENV=development
