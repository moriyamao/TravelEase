# Copy this file to .env and fill in real values.
# .env must NEVER be committed to Git.

DB_HOST=127.0.0.1
DB_NAME=travelease
DB_USER=root
DB_PASS=
DB_PORT=3306

# Used for session/CSRF token generation. Generate a long random string.
APP_SECRET=change_this_to_a_long_random_string

# From Google Cloud Console > APIs & Services > Credentials.
# This is the CLIENT ID only -- it is safe to expose to the browser.
# The client secret is NOT used by this app (ID token verification
# does not require it) and should never be placed here or anywhere
# in source code.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Set to "development" or "production".
# In production, error details are never shown to users.
APP_ENV=development

# Public base URL used in verification links (no trailing slash).
# Required: links are never built from the request's Host header.
# Production: https://travelease-zp7o.onrender.com
APP_URL=http://localhost:8000

# Verification emails are sent through Brevo's HTTPS API (Render's free
# tier blocks SMTP). Create the API key in Brevo > SMTP & API > API Keys.
# MAIL_FROM_EMAIL must be a sender verified in Brevo > Senders.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=TravelEase

# Optional live place search/nearby service. Keep this key server-side.
# Saved places and maps remain available without it.
GEOAPIFY_API_KEY=

# FR-24 private documents. Secret key is server-only (sb_secret_...), never public.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=travelease-documents

# Where per-IP rate limits get the visitor's address:
#   remote_addr (default)      REMOTE_ADDR; X-Forwarded-For only from TRUSTED_PROXIES
#   header:CF-Connecting-IP    a header set by a proxy the app is only reachable through
#   none                       no per-IP limits (the Docker image default, used on Render)
CLIENT_IP_SOURCE=
# Proxies allowed to set X-Forwarded-For (comma-separated IPs/CIDRs). Leave empty locally.
# Render publishes no ingress ranges, so do not use this on Render.
TRUSTED_PROXIES=
